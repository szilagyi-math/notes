    "check:links": "python3 tools/check_links.py",
    "check:privacy": "python3 tools/privacy/check.py",
    "check:privacy:staged": "python3 tools/privacy/check.py --staged",
    "test:privacy": "python3 -m unittest discover -s tools/privacy -p \"test_*.py\"",
    "prepare": "node tools/install-hooks.mjs"
  },
  "dependencies": {
